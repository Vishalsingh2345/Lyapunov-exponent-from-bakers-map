import os
import numpy as np

HERE = os.path.dirname(os.path.abspath(__file__))

# 1. Baker's Map dynamics
def baker_map_step(x, y, alpha):
    """One iteration of the Baker's Map (alpha in (0,1])."""
    if x <= 0.5:
        return 2 * alpha * x, alpha * y / 2
    else:
        return alpha * (2 * x - 1), alpha * (y + 1) / 2


def baker_map_x_series(alpha, n_transient, n_series, rng):
    """Run the map and return a length-n_series array of x only."""
    x, y = rng.random(), rng.random()
    for _ in range(n_transient):           # transient: settle onto attractor
        x, y = baker_map_step(x, y, alpha)
    xs = np.empty(n_series, dtype=np.float64)
    for i in range(n_series):              # recorded series
        xs[i] = x
        x, y = baker_map_step(x, y, alpha)
    return xs


# 2. Ground-truth Lyapunov exponents (exact formula)

def lyapunov_exponents(alpha):
    lam1 = np.log(2 * alpha)
    lam2 = np.log(alpha / 2)
    return lam1, lam2



# 3. Settings
N_SAMPLES   = 6000
SERIES_LEN  = 1000
N_TRANSIENT = 1000
ALPHA_MIN, ALPHA_MAX = 0.55, 1.0    # chaotic regime only
SEED = 42

# 4. Generate the raw dataset
rng = np.random.default_rng(SEED)
alphas = rng.uniform(ALPHA_MIN, ALPHA_MAX, size=N_SAMPLES)

X = np.empty((N_SAMPLES, SERIES_LEN), dtype=np.float32)
Y = np.empty((N_SAMPLES, 2), dtype=np.float32)

for i, alpha in enumerate(alphas):
    xs = baker_map_x_series(alpha, N_TRANSIENT, SERIES_LEN, rng)
    X[i] = xs.astype(np.float32)
    Y[i] = lyapunov_exponents(alpha)

print(f"Generated {N_SAMPLES} raw samples")


# 5. Remove near-duplicate series
keep = np.ones(N_SAMPLES, dtype=bool)
order = np.argsort(alphas)
for k in range(1, len(order)):
    i, j = order[k - 1], order[k]
    if keep[i] and np.max(np.abs(X[i] - X[j])) < 1e-4:
        keep[j] = False

X, Y, alphas = X[keep], Y[keep], alphas[keep]
N = X.shape[0]
print(f"Kept {N} / {N_SAMPLES} samples after removing near-duplicates")

flat = np.array([np.std(x) < 1e-4 for x in X])
print(f"Flat/degenerate series remaining: {flat.sum()} / {N} (should be 0)")

# 6. Save the RAW dataset (not yet split)

out_path = os.path.join(HERE, "bakers_map_raw.npz")
np.savez(out_path, X=X, Y=Y, alpha=alphas)
print(f"\nSaved raw dataset ({N} samples) to {out_path}")
print("Next step: run 2_split_data.py")
